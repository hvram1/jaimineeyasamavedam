% --- STACKING COMMANDS: Uniform Baseline Swara ABOVE the syllable ---
% Absolute baseline-relative overlay ensuring 100% constant horizontal swara baseline
\newlength{\swarabasew}
\newlength{\swaratopw}
\newcommand{\swarastack}[2]{%
  \settowidth{\swarabasew}{#1}%
  \settowidth{\swaratopw}{#2}%
  \ifdim\swaratopw>\swarabasew
    \mbox{#1\hspace{-\swarabasew}\makebox[\swaratopw][l]{\raisebox{2.35ex}[0pt][0pt]{#2}}\hspace{\dimexpr\swaratopw-\swarabasew+1.5pt\relax}}%
  \else
    \mbox{#1\hspace{-\swarabasew}\makebox[\swarabasew][c]{\raisebox{2.35ex}[0pt][0pt]{#2}}}%
  \fi
}
\newcommand{\stackcenter}[2]{\swarastack{#1}{#2}}
\newcommand{\stackleft}[2]{\swarastack{#1}{#2}}

% --- STACK CONFIG ---
\def\stackalignment{c}
\def\stacktype{L}
\setstackgap{L}{0.7\baselineskip}

% --- VEDIC ACCENT STACKING MACROS FOR MALAYALAM ---
% Uses AdishilaSanVedicBold for authentic Vedic accents with exact bottom-alignment
\newlength{\rikbasew}
\newlength{\riktopw}
\newcommand{\rikstack}[2]{%
  \settowidth{\rikbasew}{#1}%
  \settowidth{\riktopw}{#2}%
  \ifdim\riktopw>\rikbasew
    \stackengine{0pt}{\vphantom{ത}#1}{#2}{O}{l}{F}{T}{S}\hspace{\dimexpr\riktopw-\rikbasew+0.5pt\relax}%
  \else
    \stackengine{0pt}{\vphantom{ത}#1}{#2}{O}{c}{F}{T}{S}%
  \fi
}
\newcommand{\rikSwarita}[1]{\rikstack{#1}{{\devafont\fontsize{15pt}{15pt}\selectfont\char"0951}}}
\newcommand{\rikAnudatta}[1]{\rikstack{#1}{{\devafont\fontsize{15pt}{15pt}\selectfont\raisebox{0.67pt}{\char"1CD2}}}}
\newcommand{\rikKampa}[1]{\rikstack{#1}{{\devafont\fontsize{15pt}{15pt}\selectfont\raisebox{-0.1pt}{\char"1CF8}}}}
\newcommand{\rikTrikampa}[1]{\rikstack{#1}{{\devafont\fontsize{15pt}{15pt}\selectfont\raisebox{-0.1pt}{\char"1CF9}}}}
\newcommand{\accentmark}[2]{{\devafont\fontsize{#1pt}{#1pt}\selectfont #2}}

