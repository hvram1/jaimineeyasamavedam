% --- STACKING COMMANDS (Strictly No Phantom Spaces) ---

\BLOCK{ if kpully }
% 1. KPULLY (Kodunthirapully Paddhati): Swara markings ABOVE the mantra text
\newcommand{\stackcenter}[2]{%
  \begingroup%
  \def\stackalignment{c}%
  \stackon{#1}{#2}%
  \endgroup%
}

\newcommand{\stackleft}[2]{%
  \begingroup%
  \def\stackalignment{c}%
  \stackon{#1}{#2}%
  \endgroup%
}
\BLOCK{ else }
% 1. STANDARD: Swara markings BELOW the mantra text
\newcommand{\stackcenter}[2]{%
  \begingroup%
  \def\stackalignment{c}%
  \stackunder{#1}{#2}%
  \endgroup%
}

\newcommand{\stackleft}[2]{%
  \begingroup%
  \def\stackalignment{c}%
  \stackunder{#1}{#2}%
  \endgroup%
}
\BLOCK{ endif }

