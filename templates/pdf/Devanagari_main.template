% ==========================================
% JINJA2 LOOP STRUCTURE
% ==========================================

\BLOCK{ for key, supersection in supersections.items() }

    % --- SUPERSECTION ---
    \cleardoublepage           
    \phantomsection              
    \BLOCK{ if supersection.supersection_title }
    \chapter*{\centering \VAR{supersection.supersection_title}}
    \addcontentsline{toc}{chapter}{\VAR{supersection.supersection_title}}
    \markboth{\VAR{supersection.supersection_title}}{\VAR{supersection.supersection_title}}
    \BLOCK{ endif }
    
    % GLUE FIX: Prevent page break between Chapter and First Section
    \nopagebreak

    \BLOCK{ set ns_sec = namespace(first_section=true) }
    \BLOCK{ for section_key, section in supersection.sections.items() }
        \BLOCK{ if section_key != 'count' }
        
            \BLOCK{ if not ns_sec.first_section }
            \clearpage
            \BLOCK{ endif }
            \BLOCK{ set ns_sec.first_section = false }

            % --- SECTION ---
            
            \phantomsection  

            \BLOCK{ if section.section_title }
            \section*{\centering \VAR{section.section_title.replace(':', 'ः')} \quad (\VAR{section.Count})}
            \BLOCK{ if toc_level == 'section' or toc_level == 'both' }
            \addcontentsline{toc}{section}{\VAR{section.section_title.replace(':', 'ः')} \quad (\VAR{section.Count})} 
            \BLOCK{ endif }
            \markright{\VAR{section.section_title.replace(':', 'ः')}}
            \nopagebreak % Keep section title with first mantra
            \BLOCK{ endif }
            
            % --- SECTION-LEVEL PROCEDURE LINK ---
            \BLOCK{ set section_procedure = none }
            \BLOCK{ for sub_key, sub in section.subsections.items() }
                \BLOCK{ if sub.procedure_ref and sub.procedure_ref.get('scope') == 'section' }
                    \BLOCK{ set section_procedure = sub.procedure_ref }
                    \BLOCK{ break }
                \BLOCK{ endif }
            \BLOCK{ endfor }
            \BLOCK{ if section_procedure }
            \footnote{\VAR{section_procedure.get('title', 'विधिः')} - \hyperref[app:\VAR{section_procedure.get('file', '').rsplit('.', 1)[0]}]{परिशिष्टम् पश्यतु (See Appendix)}}
            \BLOCK{ endif }

            \BLOCK{ set ns = namespace(prev_rik_id=none) }
            \BLOCK{ for subsection_key, subsection in section.subsections.items() }
                % --- SUBSECTIONS (Mantras) ---
                
                % Conditional rendering based on output_mode
                \BLOCK{ if output_mode == 'rik' }
                \VAR{subsection | format_rik_only(none, none, subsection.header.header, footnote_dict, ns.prev_rik_id, key ~ '_' ~ section_key ~ '_' ~ subsection_key, toc_level)}
                \BLOCK{ elif output_mode == 'samam' }
                \VAR{subsection | format_samam_only(none, none, subsection.header.header, footnote_dict, ns.prev_rik_id, key ~ '_' ~ section_key ~ '_' ~ subsection_key, toc_level)}
                \BLOCK{ elif output_mode == 'rik_nometa' }
                \VAR{subsection | format_rik_nometa(none, none, subsection.header.header, footnote_dict, ns.prev_rik_id, key ~ '_' ~ section_key ~ '_' ~ subsection_key, toc_level)}
                \BLOCK{ elif output_mode == 'samam_nometa' }
                \VAR{subsection | format_samam_nometa(none, none, subsection.header.header, footnote_dict, ns.prev_rik_id, key ~ '_' ~ section_key ~ '_' ~ subsection_key, toc_level)}
                \BLOCK{ else }
                \VAR{subsection | format_mantra_sets(none, none, subsection.header.header, footnote_dict, ns.prev_rik_id, key ~ '_' ~ section_key ~ '_' ~ subsection_key, toc_level)}
                \BLOCK{ endif }
                \BLOCK{ set ns.prev_rik_id = subsection.rik_id }
               
                                
            \BLOCK{ endfor }
        \BLOCK{ endif }
    \BLOCK{ endfor }

\BLOCK{ endfor }

